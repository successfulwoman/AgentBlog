<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon/favicon.svg" />
    <title>{Astro.props.title ? `${Astro.props.title} - ${Astro.props.siteTitle || 'AgentBlog'}` : Astro.props.siteTitle || 'AgentBlog'}</title>
    <meta name="description" content={Astro.props.description || '一个简单的个人博客'} />
    
    <!-- Open Graph -->
    <meta property="og:site_name" content={Astro.props.siteTitle || 'AgentBlog'} />
    <meta property="og:title" content={Astro.props.title || Astro.props.siteTitle || 'AgentBlog'} />
    <meta property="og:description" content={Astro.props.description || '一个简单的个人博客'} />
    <meta property="og:type" content="website" />
    
    <!-- Theme script - must be inline to avoid flash -->
    <script>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
        const hue = localStorage.getItem('hue') || '30';
        document.documentElement.style.setProperty('--hue', hue);
      })();
    </script>

    <!-- CSS variables (inline to prevent Tailwind purge) -->
    <style is:global>
      :root {
        --hue: 30;
        --page-bg: #fafafa;
        --card-bg: #ffffff;
        --card-bg-hover: #f5f5f5;
        --btn-regular-bg: #f0f0f0;
        --btn-hover-bg: #e8e8e8;
        --btn-content: #333333;
        --line-divider: #e5e5e5;
        --text-primary: #1a1a1a;
        --text-muted: #888888;
        --color-primary: hsl(var(--hue, 30), 70%, 50%);
        --color-primary-light: hsl(var(--hue, 30), 70%, 65%);
        --color-primary-dark: hsl(var(--hue, 30), 70%, 35%);
        --radius-large: 12px;
        --radius-medium: 8px;
        --radius-small: 6px;
      }
      :root.dark {
        --page-bg: #1a1a2e;
        --card-bg: #222244;
        --card-bg-hover: #2a2a50;
        --btn-regular-bg: #2a2a50;
        --btn-hover-bg: #333366;
        --btn-content: #e0e0e0;
        --line-divider: #333355;
        --text-primary: #e8e8e8;
        --text-muted: #999999;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[var(--page-bg)] text-[var(--text-primary)] transition-colors duration-300">
    <div class="top-gradient-highlight"></div>
    <slot />
  </body>
</html>
