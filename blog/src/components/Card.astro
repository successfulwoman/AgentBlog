---
export interface Props {
  title: string;
  description?: string;
  href: string;
  date?: string;
  tags?: string[];
  category?: string;
}

const { title, description, href, date, tags, category } = Astro.props;
---

<a href={href} class="card-base p-6 block animate-fade-in-up group" data-category={category || ''} data-tags={JSON.stringify(tags || [])}>
  {category && (
    <span class="inline-block text-xs font-medium px-2 py-1 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] mb-3">
      {category}
    </span>
  )}
  <h3 class="text-lg font-semibold mb-2 line-clamp-2 group-hover:text-[var(--color-primary)] transition-colors">
    {title}
  </h3>
  {description && (
    <p class="text-sm text-[var(--text-muted)] line-clamp-2 mb-4">
      {description}
    </p>
  )}
  <div class="flex items-center justify-between text-xs text-[var(--text-muted)]">
    {date && <time datetime={date}>{date}</time>}
    {tags && tags.length > 0 && (
      <div class="flex gap-1 flex-wrap">
        {tags.slice(0, 3).map(tag => (
          <span class="px-2 py-0.5 rounded-full bg-[var(--btn-regular-bg)]">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
