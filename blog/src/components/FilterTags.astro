---
interface Props {
  tags: { label: string; count?: number; active?: boolean }[];
  id?: string;
}

const { tags, id = 'filter' } = Astro.props;
---

<div class="flex flex-wrap gap-2 mb-6" id={`${id}-container`}>
  {tags.map((tag, index) => (
    <button
      class={`filter-tag ${tag.active ? 'active' : ''}`}
      data-filter={tag.label}
      id={`${id}-tag-${index}`}
    >
      {tag.label}
      {tag.count !== undefined && (
        <span class="ml-1 opacity-70">({tag.count})</span>
      )}
    </button>
  ))}
</div>

<script>
  (function() {
    const container = document.getElementById('{id}-container');
    if (!container) return;
    
    container.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-tag');
      if (!btn) return;
      
      // Toggle active
      const isActive = btn.classList.contains('active');
      container.querySelectorAll('.filter-tag').forEach(b => b.classList.remove('active'));
      
      if (!isActive) {
        btn.classList.add('active');
      }
      
      // Dispatch custom event
      const filter = isActive ? 'all' : btn.dataset.filter;
      window.dispatchEvent(new CustomEvent('filter-change', { detail: { filter, id: '{id}' } }));
    });
  })();
</script>
