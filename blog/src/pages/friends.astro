---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';

const siteTitle = 'AgentBlog';

const friends = [
  { name: '素鱼', description: '一个简单的博客', url: 'https://blog.28453677.xyz', avatar: 'S' },
  { name: 'Astro', description: '现代化的静态站点生成器', url: 'https://astro.build', avatar: 'A' },
  { name: 'Tailwind CSS', description: '实用优先的 CSS 框架', url: 'https://tailwindcss.com', avatar: 'T' },
  { name: 'GitHub', description: '全球最大的代码托管平台', url: 'https://github.com', avatar: 'G' },
  { name: 'Vercel', description: '现代化的部署平台', url: 'https://vercel.com', avatar: 'V' },
  { name: 'MDN', description: 'Web 开发文档', url: 'https://developer.mozilla.org', avatar: 'M' },
];
---

<BaseLayout title="友链" siteTitle={siteTitle}>
  <Header />
  <Banner title="友链" subtitle="朋友们" height="half" />

  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Search -->
    <div class="mb-6">
      <input
        type="text"
        id="friend-search"
        placeholder="搜索友链..."
        class="w-full max-w-md px-4 py-3 rounded-lg border border-[var(--line-divider)] bg-[var(--card-bg)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary)] transition-colors"
      />
    </div>

    <!-- Friends Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="friends-grid">
      {friends.map((friend, i) => (
        <a
          href={friend.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`card-base p-5 flex items-center gap-4 animate-fade-in-up stagger-${(i % 6) + 1}`}
          data-name={friend.name}
        >
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-purple-500 flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
            {friend.avatar}
          </div>
          <div class="min-w-0">
            <h3 class="font-semibold truncate">{friend.name}</h3>
            <p class="text-sm text-[var(--text-muted)] truncate">{friend.description}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="text-center mt-8 text-[var(--text-muted)] text-sm" id="no-friends" style="display:none;">
      没有找到匹配的友链
    </p>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.getElementById('friend-search')?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    let visible = 0;
    document.querySelectorAll('#friends-grid > a').forEach(card => {
      const name = card.dataset.name?.toLowerCase() || '';
      const show = !query || name.includes(query);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    document.getElementById('no-friends').style.display = visible === 0 ? '' : 'none';
  });
</script>
