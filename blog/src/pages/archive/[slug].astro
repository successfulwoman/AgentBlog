---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const blogPosts = import.meta.glob('../../content/blog/*.md', { eager: true });
  
  return Object.entries(blogPosts).map(([path, module]) => {
    const slug = path.split('/').pop()?.replace('.md', '');
    return {
      params: { slug },
      props: { 
        post: {
          slug,
          title: module.frontmatter.title,
          description: module.frontmatter.description,
          pubDate: module.frontmatter.pubDate,
          category: module.frontmatter.category,
          tags: module.frontmatter.tags || [],
          content: module.compiledContent?.() || module.rawContent?.() || '',
        }
      },
    };
  });
}

const { post } = Astro.props;
const siteTitle = 'AgentBlog';
---

<BaseLayout title={post.title} description={post.description} siteTitle={siteTitle}>
  <Header />

  <div class="banner h-[35vh] min-h-[250px] relative flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/10 to-transparent"></div>
    <div class="relative z-10 text-center px-4">
      {post.category && (
        <span class="text-xs font-medium px-3 py-1 rounded-full bg-white/20 text-white backdrop-blur-sm mb-3 inline-block">
          {post.category}
        </span>
      )}
      <h1 class="text-2xl md:text-4xl font-bold text-white drop-shadow-lg banner-title">
        {post.title}
      </h1>
      <div class="flex items-center justify-center gap-3 mt-4 text-white/70 text-sm">
        {post.pubDate && <time datetime={post.pubDate}>{post.pubDate}</time>}
        {post.tags && post.tags.length > 0 && (
          <div class="flex gap-1">
            {post.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded-full bg-white/15 text-xs backdrop-blur-sm">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <article class="card-base p-6 md:p-10 animate-fade-in-up">
      <div class="prose dark:prose-invert max-w-none">
        <Fragment set:html={post.content} />
      </div>
    </article>

    <div class="text-center mt-8">
      <a href="/archive" class="btn-regular px-5 py-2.5 rounded-lg text-sm inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        返回归档
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
