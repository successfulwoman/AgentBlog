---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
//此文件正在尝试添加至github仓库，上传测试
const siteTitle = 'AgentBlog';
---

<BaseLayout title="关于" siteTitle={siteTitle}>
  <Header />
  <Banner title="关于我" subtitle="了解我和这个博客" height="half" />

  <main class="max-w-3xl mx-auto px-4 py-8">
    <div class="card-base p-8 animate-fade-in-up space-y-6">
      <!-- Avatar & Name -->
      <div class="flex items-center gap-4">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-purple-500 flex items-center justify-center text-white text-2xl font-bold">
          AB
        </div>
        <div>
          <h2 class="text-2xl font-bold">AgentBlog</h2>
          <p class="text-[var(--text-muted)]">开发者 · 学习者 · 探索者</p>
        </div>
      </div>

      <!-- Bio -->
      <div>
        <h3 class="text-lg font-semibold mb-3">👋 关于我</h3>
        <p class="text-[var(--text-muted)] leading-relaxed">
          你好！我是一名热爱技术的开发者。这个博客记录了我的学习历程、技术探索和生活点滴。
          我的兴趣领域包括云计算、人工智能、边缘计算以及各种开发工具的使用。
          希望这里的内容能对你有所帮助！
        </p>
      </div>

      <!-- Skills -->
      <div>
        <h3 class="text-lg font-semibold mb-3">🛠️ 技能</h3>
        <div class="flex flex-wrap gap-2">
          {['Python', 'JavaScript', 'TypeScript', 'Docker', 'Linux', 'Git', 'OpenCV', 'OpenStack', 'Machine Learning', 'Deep Learning'].map(skill => (
            <span class="px-3 py-1.5 rounded-full bg-[var(--btn-regular-bg)] text-sm font-medium">{skill}</span>
          ))}
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-3">📬 联系方式</h3>
        <div class="space-y-2 text-sm">
          <p class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">GitHub:</span>
            <a href="https://github.com" class="text-[var(--color-primary)] hover:underline">github.com/agent</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">Bilibili:</span>
            <a href="https://space.bilibili.com" class="text-[var(--color-primary)] hover:underline">bilibili空间</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">Email:</span>
            <a href="mailto:hello@agentblog.com" class="text-[var(--color-primary)] hover:underline">hello@agentblog.com</a>
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
